{
  "name": "json-formatter-extension",
  "version": "1.1.0",
  "license": "MIT",
  "private": true,
  "description": "A TypeScript Chrome extension for formatting and exploring JSON.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "bun run task/build.ts",
    "build:dev": "bun run task/build.ts --dev",
    "package": "bun run build && node task/package.mts",
    "watch": "bun run task/watch.ts",
    "clean": "bun run task/clean.ts",
    "icons": "node task/icons.mts",
    "typecheck": "bun run task/typecheck.ts",
    "test": "bun run build && bun run task/test.ts",
    "test:performance": "bun run build && bun run task/test.ts --performance"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "25.9.5",
    "bun": "^1.3.14",
    "crx3": "2.0.0",
    "playwright-core": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
