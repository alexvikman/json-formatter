{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "JSON Formatter",
  "version": "1.1.1",
  "description": "Automatically formats JSON responses and lets you format pasted JSON.",
  "icons": {
    "16": "assets/icon-16.png",
    "24": "assets/icon-24.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "Open JSON Formatter in a new tab",
    "default_icon": {
      "16": "assets/icon-16.png",
      "24": "assets/icon-24.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "css": [
        "styles/page.css"
      ],
      "js": [
        "scripts/theme.js",
        "scripts/json-renderer.js",
        "scripts/page-formatter.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
